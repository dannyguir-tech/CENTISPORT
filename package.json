{
  "name": "centisport",
  "version": "0.1.0",
  "description": "Sports Money collector MVP for Polymarket exports",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "scan:once": "SCAN_ONCE=true node src/index.js",
    "migrate": "node src/migrate.js",
    "playwright:install": "playwright install chromium",
    "research:collect": "node research/collect.js",
    "research:build": "node research/build-dataset.js",
    "research:backtest": "node research/backtest.js",
    "research:selftest": "node research/selftest.js",
    "research:test": "node --test \"research/test/*.test.js\"",
    "research:mock": "node research/test/mock-server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "playwright": "^1.49.1"
  },
  "devDependencies": {}
}
